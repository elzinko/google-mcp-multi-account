#!/usr/bin/env bash
# google-mcp — serveur MCP stdio (Claude Desktop, Cursor, Claude Code, …).
# Parle uniquement à la gateway locale (jamais gws directement depuis les tools).
set -euo pipefail
src="$0"
while [[ -L "$src" ]]; do src="$(readlink "$src")"; done
REPO="$(cd "$(dirname "$src")/.." && pwd)"
# Émission MAG_ (renommage GWSA_→MAG_, fiche 20260912000249823). GWSA_CLIENT reste
# lu en repli pour les configs clients legacy ; la gateway lit MAG_ en priorité.
export MAG_CLIENT="${MAG_CLIENT:-${GWSA_CLIENT:-mcp}}"
export PYTHONPATH="${REPO}${PYTHONPATH:+:$PYTHONPATH}"
# Interpréteur système (même contrainte que bin/mag — pas le python du PATH agent).
PYTHON="/usr/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON="$(command -v python3)"
cd "$REPO"
exec "$PYTHON" -m gateway "$@"
