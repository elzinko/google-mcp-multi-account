client_secret*.json
*credentials*.json
*.token
token*.json
.env
.env.*

# Divers
.DS_Store
node_modules/

# Fichiers temporaires des tests manuels (tests/manuels/*)
.e2e-tmp/

# Artefacts Python (py_compile / CI)
__pycache__/
*.pyc

# Note de handoff ezk-archive (éphémère personnel, jamais committée)
.claude/handoff.md

# Scratch de sprint ezk (éphémère, par-branche)
SPRINT.md

# Binaire Touch ID compilé localement (swiftc, plateforme-dépendant)
bin/mcp-google-mcp-multi-account

# Version DÉPLOYÉE — générée par scripts/deploy-local.sh, jamais commitée.
# C'est son absence qui fait qu'un clone de travail s'annonce « dev » (fiche 0023).
VERSION
