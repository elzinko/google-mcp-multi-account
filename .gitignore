# Jamais de secrets dans le repo — les credentials vivent dans ~/.config/gws-accounts/
client_secret*.json
*credentials*.json
*.token
token*.json
.env
.env.*

# Divers
.DS_Store
node_modules/

# Fichiers temporaires des tests manuels (tests/manuels/*)
.e2e-tmp/

# Artefacts Python (py_compile / CI)
__pycache__/
*.pyc

# Note de handoff ezk-archive (éphémère personnel, jamais committée)
.claude/handoff.md

# Scratch de sprint ezk (éphémère, par-branche)
SPRINT.md

# Binaires compilés localement (swiftc, plateforme-dépendants) — nom = PRODUCT_SLUG
bin/.build/
# Legacy (≤ 0032) : ancien binaire Touch ID à la racine de bin/, laissé sur les
# clones d'avant 0044 — gardé ignoré pour ne pas salir le worktree après upgrade
# (sinon deploy-local.sh rejette un worktree « dirty »).
bin/mcp-google-mcp-multi-account

# Version DÉPLOYÉE — générée par scripts/deploy-local.sh, jamais commitée.
# C'est son absence qui fait qu'un clone de travail s'annonce « dev » (fiche 0023).
VERSION

# Doc en ligne — build MkDocs, généré par « mkdocs build », jamais committé (fiche 0072).
_site/
.vercel
.env*
